            <Button layoutX="661.0" layoutY="496.0" mnemonicParsing="false" onAction="#deleteAccount" prefHeight="52.0" prefWidth="189.0" styleClass="black" stylesheets="@application.css" text="DELETE ACCOUNT" AnchorPane.rightAnchor="100.0" />
