<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox prefHeight="560.0" prefWidth="875.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.Controller">
   <children>
      <HBox>
         <children>
            <TextField fx:id="link" prefHeight="25.0" prefWidth="834.0" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#search" prefHeight="25.0" prefWidth="140.0" text="search" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <WebView fx:id="view" prefHeight="534.0" prefWidth="913.0" VBox.vgrow="ALWAYS" />
   </children>
</VBox>
