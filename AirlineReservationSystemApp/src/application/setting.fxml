      <VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="248.0" style="-fx-background-color: linear-gradient(to bottom right, #1E3C72, #2A5298,skyblue); -fx-padding: 0 0 0 10; -fx-background-radius: 0 25 25 0;">
