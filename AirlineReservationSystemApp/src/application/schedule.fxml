            <Button alignment="CENTER" graphicTextGap="8.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mainpage" prefHeight="52.0" prefWidth="162.0" style="-fx-background-radius: 100 0 0 100;" styleClass="dashboardBtn" stylesheets="@application.css" text="HOME PAGE" VBox.vgrow="ALWAYS">
